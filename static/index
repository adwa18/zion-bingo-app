#cards-area:not(.single) .bingo-card-grid.game-card .bc-header { font-size:clamp(7px,1.8vw,9px); font-weight:700; }
#cards-area:not(.single) .bingo-card-grid.game-card .bc-cell   { font-size:clamp(9px,2.6vw,12px); font-weight:700; }
#card2-area { border-left:2px solid var(--rose2); padding-left:5px; }

/* ═══ BINGO BUTTON ══════════════════════════════════ */
#bingo-claim-btn, #bingo-claim-btn2 {
  display:none;
  animation:bingo-pulse .7s ease infinite alternate;
}
@keyframes bingo-pulse {
  0% { box-shadow:0 0 12px rgba(0,200,117,.4); }
  100% { box-shadow:0 0 28px rgba(0,200,117,.8), 0 0 60px rgba(0,200,117,.3); }
}

/* ═══ BINGO OVERLAY ═════════════════════════════════ */
#bingo-overlay {
  position:fixed; inset:0;
  background:rgba(0,0,0,.9);
  display:flex; flex-direction:column;
  align-items:center; justify-content:center;
  z-index:8000; opacity:0; pointer-events:none;
  transition:opacity .3s; text-align:center; padding:24px;
}
#bingo-overlay.show { opacity:1; pointer-events:auto; }
.overlay-title {
  font-family:'Cormorant Garamond',serif;
  font-size:56px; font-weight:700; color:var(--em);
  text-shadow:var(--glow-em);
  animation:win-bounce .6s ease; margin-bottom:10px;
}
@keyframes win-bounce { 0%{transform:scale(.4);opacity:0}70%{transform:scale(1.1)}100%{transform:scale(1);opacity:1} }
#overlay-prize {
  font-family:'DM Mono',monospace; font-size:28px;
  color:var(--gold); text-shadow:var(--glow-g); margin-bottom:8px;
}
#overlay-msg { font-size:13px; color:var(--text2); }
.confetti-wrap { position:fixed; inset:0; pointer-events:none; z-index:7999; overflow:hidden; }

/* ═══ MODAL ════════════════════════════════════════ */
.modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,.7); z-index:7000; display:none; align-items:flex-end; justify-content:center; }
.modal-overlay.open { display:flex; }
.modal-sheet {
  background:var(--surf); border:1px solid var(--border2);
  border-radius:20px 20px 0 0; padding:22px;
  width:100%; max-width:480px;
  animation:sheet-up .25s ease;
}
@keyframes sheet-up { from{transform:translateY(100%)}to{transform:translateY(0)} }
.modal-title { font-family:'Cormorant Garamond',serif; font-size:18px; font-weight:700; color:var(--text); margin-bottom:12px; }
.modal-btns { display:flex; gap:10px; margin-top:16px; }

/* ═══ RESULT SCREEN ════════════════════════════════ */
.result-icon { font-size:52px; margin-bottom:10px; }
.result-title { font-family:'Cormorant Garamond',serif; font-size:32px; font-weight:700; margin-bottom:6px; }
.result-prize { font-family:'DM Mono',monospace; font-size:24px; color:var(--gold); text-shadow:var(--glow-g); margin-bottom:6px; }
.result-sub { font-size:12px; color:var(--text3); }

/* ═══ LEADERBOARD / HISTORY ════════════════════════ */
.lb-row { display:flex; align-items:center; gap:12px; padding:12px 0; border-bottom:1px solid var(--border); }
.lb-row:last-child { border-bottom:none; }
.lb-rank { font-family:'Cormorant Garamond',serif; font-size:16px; color:var(--text3); width:32px; flex-shrink:0; text-align:center; }
.lb-rank.r1 { color:var(--gold); font-size:22px; text-shadow:var(--glow-g); }
.lb-rank.r2 { color:#c0c0c0; }
.lb-rank.r3 { color:#cd7f32; }
.lb-name { flex:1; font-weight:700; font-size:14px; }
.lb-wins { font-family:'DM Mono',monospace; font-size:11px; color:var(--em); }
.lb-sub { font-size:10px; color:var(--text3); }
.hist-row { display:flex; align-items:center; gap:10px; padding:10px 0; border-bottom:1px solid var(--border); }
.hist-icon { font-size:20px; flex-shrink:0; width:26px; text-align:center; }
.hist-detail { flex:1; }
.hist-label { font-size:12px; font-weight:700; }
.hist-date { font-size:10px; color:var(--text3); margin-top:1px; }
.hist-amount { font-family:'DM Mono',monospace; font-size:13px; font-weight:700; }

/* ═══ TABS ══════════════════════════════════════════ */
.tab-row {
  display:flex; gap:0;
  background:var(--surf2); border:1px solid var(--border);
  border-radius:12px; padding:3px; margin-bottom:16px;
}
.tab-btn {
  flex:1; background:none; border:none; border-radius:9px;
  padding:9px; font-family:'Syne',sans-serif;
  font-size:11px; font-weight:700; letter-spacing:.5px;
