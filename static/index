async function proceedToGame() {
  try {
    if (S.pickedNumber) {
      const nowTaken = [..._lastTakenNumbers];
      if (!nowTaken.includes(S.pickedNumber)) nowTaken.push(S.pickedNumber);
      buildNumGrid(nowTaken);
    }
    const joinBody = { picked_number: S.pickedNumber, dual_card: S.dualCard };
    if (S.dualCard && S.pickedNumber2) joinBody.picked_number2 = S.pickedNumber2;
    const res = await api('POST', '/api/games/' + S.currentGameId + '/join', joinBody);
    if (res.status === 'already_joined' || res.status === 'joined') {
      S.myCard    = res.card;
      S.myCard2   = res.card2 || null;
      S.myMarked  = res.marked_cells || [[2,2]];
      S.myMarked2 = res.marked2      || [[2,2]];
    }
    showScreen('screen-game');
    startGameScreen();
  } catch (e) {
    toast(e.message || 'Could not join — try a different number', 'error');
  }
}

/* ── GAME SCREEN ── */
function startGameScreen() {
  _inGame = true;
  S.prevCalledLen = 0;
  const ca=document.getElementById('cards-area'), c2=document.getElementById('card2-area');
  const tl=document.getElementById('game-card-title-label');
  const cb=document.getElementById('bingo-claim-btn'), cb2=document.getElementById('bingo-claim-btn2');
  if (S.myCard2) {
    if(ca)ca.classList.remove('single'); if(c2)c2.style.display='flex';
    if(tl)tl.textContent='CARD 1'; if(cb2)cb2.style.display='inline-flex';
  } else {
    if(ca)ca.classList.add('single'); if(c2)c2.style.display='none';
    if(tl)tl.textContent='MY BINGO CARD'; if(cb2)cb2.style.display='none';
  }
  if(cb)cb.style.display='inline-flex';
  renderGameCard();
  if(S.myCard2) renderGameCard2();
  pollGame();
  function _scheduleGamePoll() {
    const interval = _gameIsActive ? 2000 : 3000;
    S.gamePolling = setTimeout(async () => {
      await pollGame();
      if (S.currentGameId) _scheduleGamePoll();
    }, interval);
  }
  _scheduleGamePoll();
}

async function pollGame() {
  if (!S.currentGameId) return;
  try {
    const gm = await api('GET', '/api/games/' + S.currentGameId);
    if (gm.my_player) {
      if (!S.myCard && gm.my_player.card) { S.myCard=gm.my_player.card; renderGameCard(); }
      if (!S.myCard2 && gm.my_player.card2) {
        S.myCard2=gm.my_player.card2; S.dualCard=true;
        const ca=document.getElementById('cards-area'),c2=document.getElementById('card2-area');
        const cb2=document.getElementById('bingo-claim-btn2'),tl=document.getElementById('game-card-title-label');
        if(ca)ca.classList.remove('single'); if(c2)c2.style.display='flex';
        if(cb2)cb2.style.display='inline-flex'; if(tl)tl.textContent='CARD 1';
        renderGameCard2();
      }
      S.myMarked  = gm.my_player.marked_cells || [[2,2]];
      S.myMarked2 = gm.my_player.marked2      || [[2,2]];
      if (gm.my_player.kicked) { clearTimeout(S.gamePolling); showResult(false,0,null,true); return; }
    }
    if (gm.status === 'finished') {
      clearTimeout(S.gamePolling);
      handleGameFinished(gm);
      return;
    }
    const leaveBtn = document.getElementById('leave-btn');
    if (gm.status === 'waiting' || gm.status === 'countdown') {
      if (leaveBtn) leaveBtn.textContent = 'Leave Game';
      showPhase('phase-waiting');
      document.getElementById('game-player-count').textContent = gm.player_count + ' player' + (gm.player_count!==1?'s':'');
      document.getElementById('game-room-label').textContent = gm.id;
      if (gm.status === 'waiting') {
        _stopCountdownTick(); _stopCallTicker();
        _countdownStarted = false; _gameIsActive = false;
        document.getElementById('countdown-display').textContent = formatTime(30);
        document.getElementById('waiting-status-msg').textContent = '⏳ Waiting for another player…';
        document.getElementById('game-status-chip').innerHTML = '<div class="chip chip-amber">WAITING</div>';
      } else {
        const serverSecs = gm.countdown_remaining ?? 30;
        if (!_countdownStarted || Math.abs(_countdownValue - serverSecs) > 2) {
          _startCountdownTick(serverSecs);
        }
        _countdownStarted = true; _gameIsActive = false;
        document.getElementById('waiting-status-msg').textContent = '✅ Countdown started! Get ready…';
        document.getElementById('game-status-chip').innerHTML = '<div class="chip chip-green"><span class="pulse-dot" style="width:5px;height:5px"></span>COUNTDOWN</div>';
      }
    }
    if (gm.status === 'active') {
      if (leaveBtn) leaveBtn.textContent = 'Forfeit Game';
      _stopCountdownTick(); _gameIsActive = true;
      showPhase('phase-active');
      const called = gm.called_numbers || [];
      document.getElementById('called-count').textContent = called.length;
      document.getElementById('active-player-count').textContent = gm.player_count + ' players';
      if (gm.server_time) _clockOffset = gm.server_time * 1000 - Date.now();
      if (called.length > 0) {
        _calledNumbers = called;
        _gameStartedAt = gm.started_at || 0;
        _callInterval  = gm.call_interval || 3;
        if (!_callTicker) _startCallTicker();
      }
      S.prevCalledLen = called.length;
    }
  } catch (e) { console.warn('poll error', e.message); }
}

function showPhase(id) {
  document.querySelectorAll('.phase').forEach(p=>p.classList.remove('active'));
  document.getElementById(id)?.classList.add('active');
}

function renderCalledBubbles(called) {
  const wrap = document.getElementById('called-numbers-wrap');
  if (!wrap) return;
  const last10 = [...called].slice(-10).reverse();
  wrap.innerHTML = last10.map((n,i) =>
    `<div class="cb-bubble ${i===0?'latest':''}">${n}</div>`
  ).join('');
}

function renderGameCard()  { buildCard('game-card-grid',  S.myCard,  S.myMarked,  1); }
function renderGameCard2() { buildCard('game-card2-grid', S.myCard2, S.myMarked2, 2); }
function buildCard(elId, card, marked, cardId) {
  const el = document.getElementById(elId);
  if (!el || !card) return; el.innerHTML='';
  ['B','I','N','G','O'].forEach(l=>{const h=document.createElement('div');h.className='bc-header';h.textContent=l;el.appendChild(h);});
  for (let r=0;r<5;r++) for (let c=0;c<5;c++) {
    const val=card[r][c]; const div=document.createElement('div');
    const isMarked=marked.some(([mr,mc])=>mr===r&&mc===c);
    let cls='bc-cell';
    if (val==='FREE') cls+=' free marked';
    else if (isMarked) cls+=' marked';
    div.className=cls; div.textContent=val;
    if (val!=='FREE') div.onclick=()=>markCell(div,r,c,val,cardId);
    el.appendChild(div);
  }
}

async function markCell(el, r, c, val, cardId=1) {
  try {
    const res = await api('POST', `/api/games/${S.currentGameId}/mark`, {row:r,col:c,card_id:cardId});
    if (cardId===2) { S.myMarked2=res.marked_cells; buildCard('game-card2-grid',S.myCard2,S.myMarked2,2); }
    else            { S.myMarked =res.marked_cells; buildCard('game-card-grid', S.myCard, S.myMarked, 1); }
  } catch(e) { toast(e.message,'error'); }
}

function checkLocalBingo() {
  const card=S.myCard, marked=S.myMarked;
  if (!card) return false;
  const s=new Set(marked.map(([r,c])=>r+','+c));
  const ok=(r,c)=>s.has(r+','+c);
  for(let r=0;r<5;r++) if([0,1,2,3,4].every(c=>ok(r,c))) return true;
  for(let c=0;c<5;c++) if([0,1,2,3,4].every(r=>ok(r,c))) return true;
  if([0,1,2,3,4].every(i=>ok(i,i))) return true;
  if([0,1,2,3,4].every(i=>ok(i,4-i))) return true;
  if([[0,0],[0,4],[4,0],[4,4]].every(([r,c])=>ok(r,c))) return true;
  return false;
}

