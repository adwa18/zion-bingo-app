}
.cb-bubble.latest { background:rgba(232,149,109,.1); border-color:var(--rose2); color:var(--rose); }
.called-count-label { font-size:10px; color:var(--text3); white-space:nowrap; text-align:right; }

/* ═══ GAME CARD AREA ═══════════════════════════════ */
.game-bottom {
  flex:1 1 0; overflow:hidden;
  padding:6px 10px 4px;
  display:flex; flex-direction:column; gap:4px; min-height:0;
}
#cards-area {
  flex:1 1 0; min-height:0;
  display:flex; gap:6px; align-items:stretch; overflow:hidden;
}
.card-slot { flex:1; min-width:0; display:flex; flex-direction:column; gap:3px; }
.card-header { display:flex; align-items:center; justify-content:space-between; flex-shrink:0; padding:0 2px; }
.card-label { font-family:'Cormorant Garamond',serif; font-size:13px; font-weight:700; color:var(--em); letter-spacing:.5px; }
.bingo-card-grid.game-card {
  max-width:none; margin:0;
  flex:1; min-height:0; max-height:100%;
