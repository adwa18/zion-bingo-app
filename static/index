/* ── CLOCK-DRIVEN NUMBER DISPLAY ── */
let _clockOffset   = 0;
let _gameStartedAt = 0;
let _callInterval  = 3;
let _calledNumbers = [];
let _callTicker    = null;
let _countdownStarted = false;
let _countdownValue   = 30;
let _countdownTicker  = null;

function _startCallTicker() {
  if (_callTicker) clearInterval(_callTicker);
  _callTicker = setInterval(_tickCallDisplay, 100);
}
function _stopCallTicker() {
  if (_callTicker) { clearInterval(_callTicker); _callTicker = null; }
}
function _tickCallDisplay() {
  if (!_gameStartedAt || !_calledNumbers.length) return;
  const serverNow = (Date.now() + _clockOffset) / 1000;
  const elapsed   = serverNow - _gameStartedAt;
  const idx       = Math.min(Math.floor(elapsed / _callInterval), _calledNumbers.length - 1);
  if (idx < 0) return;
  const el = document.getElementById('current-call-num');
  if (!el) return;
  if (el.dataset.idx !== String(idx)) {
    el.dataset.idx = idx;
    el.textContent = _calledNumbers[idx];
    el.classList.remove('num-pop');
    void el.offsetWidth;
    el.classList.add('num-pop');
    const cc = document.getElementById('called-count');
    if (cc) cc.textContent = idx + 1;
    renderCalledBubbles(_calledNumbers.slice(0, idx + 1));
  }
}
function _startCountdownTick(initialSecs) {
  _countdownValue = Math.max(0, initialSecs);
  if (_countdownTicker) clearInterval(_countdownTicker);
  _updateCountdownDisplay();
  _countdownTicker = setInterval(() => {
    _countdownValue = Math.max(0, _countdownValue - 1);
    _updateCountdownDisplay();
  }, 1000);
}
function _stopCountdownTick() {
  if (_countdownTicker) { clearInterval(_countdownTicker); _countdownTicker = null; }
}
function _updateCountdownDisplay() {
  const el = document.getElementById('countdown-display');
  if (el) el.textContent = formatTime(_countdownValue);
}

