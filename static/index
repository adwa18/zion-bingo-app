.phase.active { display:flex; }
.room-id { font-family:'DM Mono',monospace; font-size:10px; color:var(--text3); letter-spacing:1px; }
.waiting-status { font-size:12px; color:var(--text2); margin-top:4px; }
.countdown-wrap { display:flex; align-items:baseline; gap:6px; margin-top:6px; }
.countdown-label { font-size:9px; letter-spacing:1px; text-transform:uppercase; color:var(--text3); }
.countdown-timer {
