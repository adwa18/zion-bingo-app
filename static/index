        S.currentGameId = gid;
        if (S.selectedBet && S.pickedNumber) {
          S.lastBet=S.selectedBet; S.lastPickedNum=S.pickedNumber; S.lastPickedNum2=S.pickedNumber2;
          S.lastCard=S.myCard; S.lastCard2=S.myCard2; S.lastDual=S.dualCard;
        }
        showResult(false, 0, null, false, true, res.forfeited);
        return;
      }
    } catch(_) {}
  }
  S.currentGameId=null; S.myCard=null; S.myCard2=null;
  S.myMarked=[[2,2]]; S.myMarked2=[[2,2]]; S.dualCard=false;
  _countdownStarted=false; _gameIsActive=false; _inGame=false;
  showScreen('screen-lobby'); setActiveNav('nav-play'); startLobbyPolling();
}

