}
.tab-btn.active { background:var(--em3); color:var(--bg); box-shadow:0 0 12px rgba(0,217,138,.2); }
.tab-pane { display:none; }
.tab-pane.active { display:block; }

/* ═══ PROFILE / STATS ══════════════════════════════ */
.stat-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:8px; margin-bottom:12px; }
.stat-box {
  background:var(--surf2); border:1px solid var(--border);
  border-radius:12px; padding:14px; text-align:center;
}
.stat-val { font-family:'Cormorant Garamond',serif; font-size:26px; font-weight:700; color:var(--em); }
.stat-lbl { font-size:10px; color:var(--text3); letter-spacing:.8px; text-transform:uppercase; margin-top:3px; }
.ref-link-box {
  background:var(--surf2); border:1px solid var(--border2);
  border-radius:10px; padding:12px 14px;
  font-family:'DM Mono',monospace; font-size:11px; color:var(--em);
  word-break:break-all; margin-bottom:12px;
}

/* ═══ WALLET ════════════════════════════════════════ */
.pay-info { background:var(--surf2); border:1px solid var(--border2); border-radius:12px; padding:14px; margin-bottom:14px; }
.pay-info p { font-size:12px; line-height:2; color:var(--text2); }
.pay-info strong { color:var(--gold); font-family:'DM Mono',monospace; }

/* ═══ ADMIN ═════════════════════════════════════════ */
.admin-section-title { font-size:10px; letter-spacing:1.5px; text-transform:uppercase; color:var(--text3); margin:16px 0 8px; border-bottom:1px solid var(--border); padding-bottom:6px; }
.user-row-admin { display:flex; align-items:center; gap:10px; padding:10px 0; border-bottom:1px solid var(--border); cursor:pointer; }
.u-avatar { width:34px; height:34px; border-radius:10px; background:var(--surf3); border:1px solid var(--border2); display:flex; align-items:center; justify-content:center; font-family:'Cormorant Garamond',serif; font-weight:700; font-size:15px; color:var(--em); flex-shrink:0; }
.u-name { font-size:13px; font-weight:700; }
