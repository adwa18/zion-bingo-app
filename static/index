  grid-template-columns:repeat(5,1fr);
  grid-template-rows:auto repeat(5,1fr); overflow:hidden;
}
.bingo-card-grid.game-card .bc-header { font-size:clamp(7px,1.8vw,9px); font-weight:700; padding:2px; white-space:nowrap; }
.bingo-card-grid.game-card .bc-cell { aspect-ratio:unset; overflow:hidden; min-height:0; min-width:0; font-size:clamp(10px,2.8vw,14px); padding:1px; }
#cards-area.single .bingo-card-grid.game-card .bc-cell   { font-size:clamp(14px,4.2vw,19px); font-weight:700; }
