<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title>Benz Bingo</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=DM+Mono:wght@400;500&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════════════
   EMERALD LUXURY — DESIGN TOKENS
═══════════════════════════════════════════════ */
:root {
  --bg:       #080f0b;
  --bg2:      #0d1a11;
  --surf:     #111e15;
  --surf2:    #172119;
  --surf3:    #1e2b20;
  --border:   #1f3025;
  --border2:  #2a3d2e;
  --text:     #f0ebe1;
  --text2:    #a09880;
  --text3:    #5a6355;
  --em:       #00d98a;   /* emerald */
  --em2:      #00b373;
  --em3:      #007a4d;
  --rose:     #e8956d;   /* rose gold */
  --rose2:    #c47a54;
  --gold:     #d4a843;
  --gold2:    #b08a30;
  --cream:    #f0ebe1;
  --red:      #e05c5c;
  --glow-em:  0 0 20px rgba(0,217,138,.35), 0 0 60px rgba(0,217,138,.1);
  --glow-r:   0 0 20px rgba(232,149,109,.35);
  --glow-g:   0 0 20px rgba(212,168,67,.35);
  --nav-h:    58px;
  --hdr-h:    50px;
  --vh:       1vh;
}

*,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
html,body { height:100%; overflow:hidden; background:var(--bg); color:var(--text); }
body {
  font-family:'Syne',sans-serif;
  font-size:14px;
  line-height:1.5;
  -webkit-font-smoothing:antialiased;
}

/* Grain texture overlay */
body::after {
  content:'';
  position:fixed; inset:0;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
  pointer-events:none; z-index:9998; opacity:.6;
}

/* Scrollbar */
::-webkit-scrollbar { width:3px; }
::-webkit-scrollbar-track { background:transparent; }
::-webkit-scrollbar-thumb { background:var(--em3); border-radius:2px; }

/* ═══ APP SHELL ═══════════════════════════════ */
#app {
  position:fixed; inset:0;
  display:flex; flex-direction:column;
  overflow:hidden;
}

/* ═══ HEADER ══════════════════════════════════ */
#header {
  height:var(--hdr-h);
  background:var(--bg2);
  border-bottom:1px solid var(--border);
  display:none; align-items:center;
  justify-content:space-between;
  padding:0 16px;
  flex-shrink:0; position:relative; z-index:100;
}
#header::after {
  content:''; position:absolute;
  bottom:0; left:0; right:0; height:1px;
  background:linear-gradient(90deg,transparent,var(--em3),transparent);
}
.hdr-logo {
  font-family:'Cormorant Garamond',serif;
  font-size:20px; font-weight:700;
  color:var(--em);
  text-shadow:var(--glow-em);
  letter-spacing:1px;
}
.hdr-logo em { color:var(--rose); font-style:normal; }
.hdr-balance {
  font-family:'DM Mono',monospace;
  font-size:13px; color:var(--gold);
  background:rgba(212,168,67,.08);
  border:1px solid rgba(212,168,67,.2);
  border-radius:20px; padding:4px 12px;
}
.hdr-user { font-size:11px; color:var(--text3); letter-spacing:.5px; text-transform:uppercase; }
.hdr-right { display:flex; align-items:center; gap:10px; }

/* ═══ SCREENS ══════════════════════════════════ */
#screens { flex:1; overflow:hidden; position:relative; }
.screen {
  position:absolute; inset:0;
  overflow-y:auto; display:none; flex-direction:column;
  padding:16px 16px calc(var(--nav-h) + 36px);
}
.screen.active { display:flex; }
#screen-game { padding:0 !important; }
#screen-game.active { display:flex !important; flex-direction:column; }
#screen-welcome.active, #screen-register.active { display:flex; padding:0; }
#screen-card-preview.active { display:flex; flex-direction:column; overflow-y:auto; }

/* ═══ FLOATING PILL NAV ════════════════════════ */
#bottom-nav {
  height:var(--nav-h);
  display:none; align-items:center;
  justify-content:center;
  flex-shrink:0; padding:6px 10px;
  background:transparent;
  position:relative;
}
.nav-pill {
  display:flex; align-items:center;
  background:var(--surf);
  border:1px solid var(--border2);
  border-radius:100px;
  padding:4px;
  gap:2px;
  box-shadow:0 8px 32px rgba(0,0,0,.4), 0 0 0 1px rgba(0,217,138,.05);
}
.nav-btn {
  display:flex; flex-direction:column;
  align-items:center; gap:1px;
  background:none; border:none;
  color:var(--text3); cursor:pointer;
  padding:8px 14px;
  border-radius:100px;
  transition:all .25s;
  -webkit-tap-highlight-color:transparent;
  min-width:54px;
}
.nav-btn.active {
  background:var(--em);
  color:var(--bg);
  box-shadow:var(--glow-em);
}
.nav-ico { font-size:16px; line-height:1; }
.nav-lbl { font-size:8px; font-weight:800; letter-spacing:.8px; text-transform:uppercase; font-family:'Syne',sans-serif; }

/* ═══ CARDS / PANELS ═══════════════════════════ */
.panel {
  background:var(--surf);
  border:1px solid var(--border);
  border-radius:16px;
  padding:16px;
  margin-bottom:12px;
  position:relative; overflow:visible;
}
.panel::before {
  content:''; position:absolute;
  top:0; left:20px; right:20px; height:1px;
  background:linear-gradient(90deg,transparent,var(--border2),transparent);
  border-radius:1px;
}
.panel-em { border-color:var(--em3); }
.panel-em::before { background:linear-gradient(90deg,transparent,var(--em),transparent); }
.panel-rose { border-color:var(--rose2); }
.panel-rose::before { background:linear-gradient(90deg,transparent,var(--rose),transparent); }
.panel-gold { border-color:rgba(212,168,67,.3); }
.panel-gold::before { background:linear-gradient(90deg,transparent,var(--gold),transparent); }

/* ═══ TYPOGRAPHY ════════════════════════════════ */
.screen-title {
  font-family:'Cormorant Garamond',serif;
  font-size:22px; font-weight:700;
  color:var(--em); letter-spacing:.5px;
  margin-bottom:16px;
  text-shadow:0 0 30px rgba(0,217,138,.2);
}
.label {
  font-size:10px; font-weight:700;
  letter-spacing:1.5px; text-transform:uppercase;
  color:var(--text3); margin-bottom:6px;
}
.mono { font-family:'DM Mono',monospace; }

/* ═══ BUTTONS ═══════════════════════════════════ */
.btn {
  display:inline-flex; align-items:center;
  justify-content:center; gap:6px;
  padding:12px 22px; border-radius:12px;
  border:1px solid transparent;
  font-family:'Syne',sans-serif;
  font-weight:700; font-size:12px;
  letter-spacing:.8px; cursor:pointer;
  transition:all .2s;
  -webkit-tap-highlight-color:transparent;
  text-transform:uppercase;
}
.btn:disabled { opacity:.4; cursor:not-allowed; }
.btn:active { transform:scale(.97); }
.btn-em {
  background:linear-gradient(135deg,var(--em),var(--em2));
  border-color:var(--em); color:var(--bg);
  box-shadow:var(--glow-em);
}
.btn-rose {
  background:linear-gradient(135deg,var(--rose),var(--rose2));
  border-color:var(--rose); color:#fff;
  box-shadow:var(--glow-r);
}
.btn-gold {
  background:linear-gradient(135deg,var(--gold),var(--gold2));
  border-color:var(--gold); color:var(--bg);
  box-shadow:var(--glow-g);
}
.btn-ghost {
  background:transparent; border-color:var(--border2); color:var(--text2);
}
.btn-ghost:hover { border-color:var(--em3); color:var(--em); }
.btn-danger { background:transparent; border-color:var(--red); color:var(--red); }
.btn-green {
  background:linear-gradient(135deg,#00c875,#009a5a);
  border-color:#00c875; color:var(--bg);
  box-shadow:0 0 16px rgba(0,200,117,.3);
}
.btn-full { width:100%; }
.btn-sm { padding:7px 14px; font-size:10px; }

/* ═══ INPUTS ═════════════════════════════════════ */
.input {
  width:100%;
  background:var(--surf2);
  border:1px solid var(--border2);
  border-radius:10px;
  padding:12px 14px;
  color:var(--text);
  font-family:'Syne',sans-serif; font-size:14px;
  outline:none; transition:border-color .2s, box-shadow .2s;
  margin-bottom:10px;
}
.input:focus { border-color:var(--em3); box-shadow:0 0 0 3px rgba(0,217,138,.07); }
.input::placeholder { color:var(--text3); }
.input-group { margin-bottom:12px; }
.input-group .label { margin-bottom:4px; }
.input-group .input { margin-bottom:0; }

/* ═══ TOAST ══════════════════════════════════════ */
#toast {
  position:fixed; top:60px; left:50%;
  transform:translateX(-50%);
  background:var(--surf2);
  border:1px solid var(--border2);
  border-radius:100px;
  padding:10px 20px;
  font-size:12px; font-weight:700;
  z-index:9000; display:none;
  white-space:nowrap; max-width:88vw;
  text-overflow:ellipsis; overflow:hidden;
  box-shadow:0 8px 32px rgba(0,0,0,.5);
  letter-spacing:.3px;
}
#toast.show { display:block; animation:toast-in .2s ease; }
#toast.success { border-color:var(--em2); color:var(--em); }
#toast.error   { border-color:var(--red); color:var(--red); }
#toast.info    { border-color:var(--em3); color:var(--text2); }
@keyframes toast-in { from{opacity:0;transform:translateX(-50%) translateY(-10px)}to{opacity:1;transform:translateX(-50%) translateY(0)} }

/* ═══ WELCOME ════════════════════════════════════ */
#screen-welcome {
  background:var(--bg);
  align-items:center; justify-content:center;
  padding:0; position:relative; overflow:hidden;
}
.welcome-bg {
  position:absolute; inset:0;
  background:
    radial-gradient(ellipse 70% 50% at 30% 20%, rgba(0,217,138,.06) 0%, transparent 60%),
    radial-gradient(ellipse 50% 40% at 80% 70%, rgba(232,149,109,.05) 0%, transparent 50%),
    radial-gradient(ellipse 80% 60% at 50% 100%, rgba(0,217,138,.04) 0%, transparent 50%);
}
/* Decorative orbs */
.welcome-bg::before, .welcome-bg::after {
  content:''; position:absolute; border-radius:50%;
  filter:blur(60px); opacity:.15;
}
.welcome-bg::before {
  width:200px; height:200px;
  background:var(--em); top:-50px; left:-50px;
  animation:orb-float 8s ease-in-out infinite;
}
.welcome-bg::after {
  width:150px; height:150px;
  background:var(--rose); bottom:-30px; right:-30px;
  animation:orb-float 10s ease-in-out infinite reverse;
}
@keyframes orb-float {
  0%,100%{transform:translate(0,0)}
  50%{transform:translate(20px,20px)}
}
.welcome-inner { position:relative; text-align:center; padding:40px 28px; }
.welcome-logo {
  font-family:'Cormorant Garamond',serif;
  font-size:48px; font-weight:700;
  color:var(--em); letter-spacing:2px;
  text-shadow:var(--glow-em);
  line-height:1;
  animation:logo-reveal 1s ease both;
}
.welcome-logo span { color:var(--rose); }
@keyframes logo-reveal {
  from{opacity:0;transform:translateY(-20px)}to{opacity:1;transform:none}
}
.welcome-tagline {
  font-size:10px; letter-spacing:3px;
  text-transform:uppercase; color:var(--text3);
  margin:8px 0 36px;
  animation:logo-reveal .8s ease .2s both;
}
.welcome-greeting {
  font-size:17px; color:var(--text2);
  margin-bottom:32px; font-weight:400;
  animation:logo-reveal .8s ease .3s both;
}
.welcome-greeting strong { color:var(--cream); font-weight:700; }
/* Decorative line */
.welcome-line {
  width:60px; height:1px;
  background:linear-gradient(90deg,transparent,var(--em),transparent);
  margin:0 auto 32px;
  animation:logo-reveal .8s ease .4s both;
}
.btn-welcome-wrap { animation:logo-reveal .8s ease .5s both; }

/* ═══ REGISTER ═══════════════════════════════════ */
#screen-register {
  padding:28px 20px; justify-content:center;
}
.reg-ornament {
  text-align:center; margin-bottom:24px;
}
.reg-ornament .reg-logo {
  font-family:'Cormorant Garamond',serif;
  font-size:24px; font-weight:700; color:var(--em);
  text-shadow:var(--glow-em);
}
.reg-ornament .reg-sub { font-size:11px; color:var(--text3); margin-top:4px; }
.bonus-badge {
  background:linear-gradient(135deg,rgba(212,168,67,.1),rgba(212,168,67,.05));
  border:1px solid rgba(212,168,67,.25);
  border-radius:10px; padding:10px 14px;
  font-size:11px; color:var(--gold);
  text-align:center; margin-bottom:20px;
}

/* ═══ LOBBY ══════════════════════════════════════ */
.bet-grid {
  display:grid; grid-template-columns:repeat(2,1fr);
  gap:10px; margin-bottom:16px;
}
.bet-tile {
  background:var(--surf); border:1px solid var(--border);
  border-radius:16px; padding:18px 12px;
  text-align:center; cursor:pointer;
  transition:all .25s; position:relative; overflow:hidden;
}
.bet-tile::after {
  content:''; position:absolute;
  top:-50%; left:-50%; width:200%; height:200%;
  background:radial-gradient(ellipse at center, rgba(0,217,138,.06) 0%, transparent 60%);
  opacity:0; transition:opacity .3s;
}
.bet-tile:hover::after, .bet-tile.selected::after { opacity:1; }
.bet-tile.selected {
  border-color:var(--em3);
  background:rgba(0,217,138,.05);
  box-shadow:0 0 0 1px var(--em3), inset 0 0 20px rgba(0,217,138,.04);
}
.bet-tile:active { transform:scale(.97); }
.bet-amount {
  font-family:'Cormorant Garamond',serif;
  font-size:32px; font-weight:700;
  color:var(--gold); text-shadow:var(--glow-g);
  line-height:1; margin-bottom:2px;
}
.bet-unit { font-size:10px; color:var(--text3); letter-spacing:1px; text-transform:uppercase; }
.bet-players {
  display:flex; align-items:center;
  justify-content:center; gap:4px;
  margin-top:10px; font-size:10px; color:var(--text3);
}
.pulse-dot {
  width:5px; height:5px; border-radius:50%;
  background:var(--em); box-shadow:0 0 6px var(--em);
  animation:pulse-dot .9s ease-in-out infinite alternate;
}
@keyframes pulse-dot { to { opacity:.3; box-shadow:none; } }

.game-item {
  background:var(--surf); border:1px solid var(--border);
  border-radius:12px; padding:12px 14px;
  margin-bottom:8px; display:flex;
  align-items:center; justify-content:space-between; gap:10px;
}
.game-id { font-family:'DM Mono',monospace; font-size:12px; color:var(--em); }
.game-meta { font-size:11px; color:var(--text3); margin-top:2px; }
.game-pot { font-size:11px; color:var(--gold); margin-top:2px; font-family:'DM Mono',monospace; }

/* ═══ CHIPS ══════════════════════════════════════ */
.chip {
  display:inline-flex; align-items:center; gap:4px;
  border-radius:100px; padding:3px 12px;
  font-size:10px; font-weight:700; letter-spacing:.8px; text-transform:uppercase;
}
.chip-em   { background:rgba(0,217,138,.1); border:1px solid var(--em3); color:var(--em); }
.chip-gold { background:rgba(212,168,67,.1); border:1px solid rgba(212,168,67,.3); color:var(--gold); }
.chip-green { background:rgba(0,200,117,.1); border:1px solid rgba(0,200,117,.3); color:#00c875; }
.chip-red  { background:rgba(224,92,92,.1); border:1px solid rgba(224,92,92,.3); color:var(--red); }

/* ═══ PICKER ══════════════════════════════════════ */
.picker-bar {
  background:var(--surf); border:1px solid var(--border);
  border-radius:12px; padding:10px 14px;
  margin-bottom:12px; display:none;
  grid-template-columns:repeat(3,1fr); gap:8px; text-align:center;
}
.picker-bar.visible { display:grid; }
.pb-val { font-family:'DM Mono',monospace; font-size:16px; color:var(--em); font-weight:700; }
.pb-lbl { font-size:9px; color:var(--text3); letter-spacing:.8px; text-transform:uppercase; margin-top:1px; }

.num-grid { display:grid; grid-template-columns:repeat(10,1fr); gap:4px; margin-bottom:12px; }
.num-cell {
  aspect-ratio:1; display:flex; align-items:center; justify-content:center;
  background:var(--surf2); border:1px solid var(--border);
  border-radius:6px; font-family:'DM Mono',monospace;
  font-size:11px; font-weight:500; color:var(--text2);
  cursor:pointer; transition:all .15s;
  -webkit-tap-highlight-color:transparent;
}
.num-cell:hover { border-color:var(--em3); color:var(--em); background:rgba(0,217,138,.05); }
.num-cell.taken { background:rgba(224,92,92,.08); border-color:rgba(224,92,92,.3); color:var(--red); cursor:not-allowed; opacity:.7; }
.num-cell.chosen {
  background:linear-gradient(135deg,rgba(0,217,138,.2),rgba(0,179,115,.12));
  border-color:var(--em); color:var(--em);
  box-shadow:var(--glow-em); transform:scale(1.08);
}
.num-cell.chosen2 {
  background:linear-gradient(135deg,rgba(232,149,109,.2),rgba(196,122,84,.12));
  border-color:var(--rose); color:var(--rose);
  box-shadow:var(--glow-r); transform:scale(1.08);
}

.chosen-panel {
  background:var(--surf); border:1px solid var(--em3);
  border-radius:14px; padding:14px 16px;
  margin-bottom:12px; display:none;
  position:relative; overflow:hidden;
}
.chosen-panel::before {
  content:''; position:absolute;
  top:0; left:0; right:0; height:1px;
  background:linear-gradient(90deg,transparent,var(--em),transparent);
}
.chosen-num-display {
  font-family:'Cormorant Garamond',serif;
  font-size:48px; font-weight:700; color:var(--em);
  text-shadow:var(--glow-em); line-height:1;
}
.chosen-panel-2 {
  background:var(--surf); border:1px solid var(--rose2);
  border-radius:14px; padding:14px 16px;
  margin-bottom:12px; position:relative; overflow:hidden;
}
.chosen-panel-2::before {
  content:''; position:absolute;
  top:0; left:0; right:0; height:1px;
  background:linear-gradient(90deg,transparent,var(--rose),transparent);
}
.dual-toggle-wrap {
  background:var(--surf2); border:1px solid var(--border2);
  border-radius:10px; padding:12px 14px;
  margin-bottom:10px; display:flex;
  align-items:center; justify-content:space-between; gap:10px;
}
.toggle-knob {
  width:44px; height:24px; border-radius:12px;
  background:var(--surf3); border:2px solid var(--border2);
  cursor:pointer; transition:all .25s; position:relative; flex-shrink:0;
}
.toggle-dot {
  width:18px; height:18px; border-radius:50%; background:#555;
  position:absolute; top:1px; left:1px; transition:all .25s;
}
#picker-started-warn {
  display:none; background:rgba(224,92,92,.08);
  border:1px solid rgba(224,92,92,.3); border-radius:8px;
  padding:8px 12px; font-size:11px; color:var(--red); margin-bottom:10px;
}

/* ═══ CARD PREVIEW ════════════════════════════════ */
#screen-card-preview .panel { flex-shrink:0; }
#preview-cards-wrap { align-items:stretch !important; }
#preview-card1-outer {
  max-width:min(88vw,340px); width:100%;
  margin:0 auto; display:flex; flex-direction:column;
}
#preview-card2-wrap { display:flex; flex-direction:column; }
#preview-card1-outer .panel, #preview-card2-wrap .panel { display:flex; flex-direction:column; }
#screen-card-preview.dual #preview-card1-outer { max-width:none; flex:1; margin:0; }
#preview-card-grid, #preview-card2-grid { height:auto; width:100%; }
#preview-card-grid .bc-header, #preview-card2-grid .bc-header,
#preview-card-grid .bc-cell, #preview-card2-grid .bc-cell {
  aspect-ratio:1; font-size:clamp(12px,3.5vw,16px); font-weight:700;
}
#preview-card-grid .bc-cell.free, #preview-card2-grid .bc-cell.free { font-size:clamp(8px,2.2vw,11px); }
#screen-card-preview.dual #preview-card-grid .bc-header,
#screen-card-preview.dual #preview-card2-grid .bc-header,
#screen-card-preview.dual #preview-card-grid .bc-cell,
#screen-card-preview.dual #preview-card2-grid .bc-cell { font-size:clamp(10px,2.8vw,13px); font-weight:700; }

/* ═══ BINGO CARD CELLS — EMERALD THEME ════════════ */
.bingo-card-grid {
  display:grid; grid-template-columns:repeat(5,1fr);
  gap:3px; width:100%; height:100%;
}
.bc-header {
  background:var(--surf3); border:1px solid var(--em3);
  border-radius:5px; display:flex; align-items:center; justify-content:center;
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(11px,2.8vw,14px); font-weight:700;
  color:var(--em); text-shadow:0 0 8px rgba(0,217,138,.4); aspect-ratio:1;
}
.bc-cell {
