/* ── PICKER ── */
let _lastTakenNumbers = [];
let _lastPrize = 0;
let _pickerPollInterval = null;
let _pickerWaitTimer = null;
let _gameIsActive = false;

function stopPickerPoll() {
  if (_pickerPollInterval) { clearInterval(_pickerPollInterval); _pickerPollInterval = null; }
  if (_pickerWaitTimer)    { clearInterval(_pickerWaitTimer); _pickerWaitTimer = null; }
}

function _updatePickerBar(gm) {
  const bar = document.getElementById('picker-game-bar');
  if (!bar) return;
  bar.classList.add('visible');
  document.getElementById('picker-player-count').textContent = gm.player_count || 0;
  document.getElementById('picker-pot').textContent = (gm.pot||0).toLocaleString();
  const cdWrap = document.getElementById('picker-countdown-wrap');
  if (gm.status === 'countdown' && gm.countdown_remaining > 0) {
    if (cdWrap) cdWrap.style.display = 'block';
    document.getElementById('picker-countdown').textContent = formatTime(gm.countdown_remaining);
  } else {
    if (cdWrap) cdWrap.style.display = 'none';
  }
  const previewBtn = document.getElementById('preview-btn');
  const startedWarn = document.getElementById('picker-started-warn');
  if (gm.status === 'active') {
    if (previewBtn) { previewBtn.disabled = true; previewBtn.style.opacity = '0.4'; }
    if (startedWarn) startedWarn.style.display = 'block';
    if (!_pickerWaitTimer) {
      let _waitSec = 60;
      const timerEl = document.getElementById('picker-wait-timer');
      if (timerEl) timerEl.textContent = _waitSec;
      _pickerWaitTimer = setInterval(() => {
        _waitSec--;
        if (timerEl) timerEl.textContent = _waitSec;
        if (_waitSec <= 0) {
          clearInterval(_pickerWaitTimer); _pickerWaitTimer = null;
          stopPickerPoll();
          S.currentGameId = null;
          showScreen('screen-lobby'); setActiveNav('nav-play'); startLobbyPolling();
          toast('Game ended — pick another lobby', 'error');
        }
      }, 1000);
    }
  } else if (gm.status === 'finished') {
    if (previewBtn) { previewBtn.disabled = false; previewBtn.style.opacity = '1'; }
    if (startedWarn) startedWarn.style.display = 'none';
    if (_pickerWaitTimer) { clearInterval(_pickerWaitTimer); _pickerWaitTimer = null; }
    api('POST', '/api/games', { bet_amount: S.selectedBet }).then(room => {
      S.currentGameId = room.id;
      toast('Game over — tap Proceed for next game!', 'info');
    }).catch(() => {});
  } else {
    if (previewBtn) { previewBtn.disabled = false; previewBtn.style.opacity = '1'; }
    if (startedWarn) startedWarn.style.display = 'none';
    if (_pickerWaitTimer) { clearInterval(_pickerWaitTimer); _pickerWaitTimer = null; }
  }
}

async function _pollPickerGame() {
  if (!S.currentGameId) return;
  try {
    const gm = await api('GET', '/api/games/' + S.currentGameId);
    _updatePickerBar(gm);
    const taken = (gm.players||[]).flatMap(p=>[p.picked_number,p.picked_number2]).filter(Boolean);
    if (taken.length !== _lastTakenNumbers.length || taken.some(n=>!_lastTakenNumbers.includes(n))) {
      buildNumGrid(taken);
    }
  } catch(_) {}
}

async function enterPickerForGame(gameId) {
  S.currentGameId = gameId;
  stopLobbyPolling();
  stopPickerPoll();
  let takenNumbers = [];
  try {
    const gm = await api('GET', '/api/games/' + gameId);
    takenNumbers = (gm.players||[]).flatMap(p=>[p.picked_number,p.picked_number2]).filter(Boolean);
    if (gm.my_player) {
      S.myCard   = gm.my_player.card;
      S.myMarked = gm.my_player.marked_cells;
      showScreen('screen-card-preview');
      renderPreview();
      return;
    }
  } catch (_) {}
  _lastTakenNumbers = takenNumbers;
  buildNumGrid(takenNumbers);
  showScreen('screen-picker');
  _pollPickerGame();
  _pickerPollInterval = setInterval(_pollPickerGame, 2000);
  S.pickedNumber = null;
  S.previewCard  = null;
  document.getElementById('picker-chosen-panel').style.display = 'none';
  document.getElementById('chosen-num-display').textContent = '—';
  // Reset picker bar
  document.getElementById('picker-game-bar').classList.remove('visible');
}

function buildNumGrid(taken = []) {
  _lastTakenNumbers = taken;
  const grid = document.getElementById('num-grid');
  const existing = grid.querySelectorAll('.num-cell');
  if (existing.length === 100) {
    existing.forEach(div => {
      const i = parseInt(div.dataset.num);
      const isTaken = taken.includes(i);
      const isChosen  = S.pickedNumber  === i;
      const isChosen2 = S.dualCard && S.pickedNumber2 === i;
      const wasTaken  = div.classList.contains('taken');
      if (!wasTaken && isTaken) {
        div.className = 'num-cell taken'; div.onclick = null;
      } else if (!isTaken) {
        let cls = 'num-cell';
        if (isChosen)  cls += ' chosen';
        if (isChosen2) cls += ' chosen2';
        if (div.className !== cls) div.className = cls;
        if (!div.onclick) div.onclick = () => pickNumber(i);
      }
    });
    return;
  }
  grid.innerHTML = '';
  for (let i = 1; i <= 100; i++) {
    const isTaken  = taken.includes(i);
    const isChosen  = S.pickedNumber  === i;
    const isChosen2 = S.dualCard && S.pickedNumber2 === i;
    let cls = 'num-cell';
    if (isTaken)   cls += ' taken';
    else if (isChosen)  cls += ' chosen';
    if (isChosen2) cls += ' chosen2';
    const div = document.createElement('div');
    div.className = cls; div.textContent = i; div.dataset.num = i;
    if (!isTaken) div.onclick = () => pickNumber(i);
    grid.appendChild(div);
  }
}

function pickNumber(n) {
  if (S.dualCard && S.pickedNumber && S.pickedNumber !== n) {
    if (S.pickedNumber2 === n) {
      S.pickedNumber2 = null;
      document.getElementById('chosen-num2-display').textContent = '—';
      document.getElementById('card2-pick-hint').style.display = 'inline';
    } else {
      S.pickedNumber2 = n;
      document.getElementById('chosen-num2-display').textContent = n;
      document.getElementById('card2-pick-hint').style.display = 'none';
    }
    buildNumGrid(_lastTakenNumbers); return;
  }
  if (S.pickedNumber2 === n) S.pickedNumber2 = null;
  S.pickedNumber = n;
  document.getElementById('chosen-num-display').textContent = n;
  document.getElementById('picker-chosen-panel').style.display = 'block';
  buildNumGrid(_lastTakenNumbers);
}

