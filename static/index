<div id="benz-footer">
  Created by <a href="tel:0913252238" onclick="if(window.Telegram?.WebApp?.openLink)window.Telegram.WebApp.openLink('tel:0913252238')">Benzion Creatives</a>
</div>

<div id="toast"></div>

<script>
/* ── vh fix ── */
function _setVh() {
  document.documentElement.style.setProperty('--vh', window.innerHeight * 0.01 + 'px');
}
window.addEventListener('resize', _setVh);
window.addEventListener('orientationchange', () => setTimeout(_setVh, 200));
_setVh();

const BET_AMOUNTS = [10, 20, 50, 100];
const API_BASE = '';

/* ── STATE ── */
const S = {
  tgUser:       null,
  user:         null,
  selectedBet:  null,
  currentGameId:null,
  myCard:        null,
  myCard2:       null,
  myMarked:      [[2,2]],
  myMarked2:     [[2,2]],
  dualCard:      false,
  pickedNumber:  null,
  pickedNumber2: null,
  previewCard:   null,
  previewCard2:  null,
  lastBet:       null,
  lastPickedNum: null,
  lastPickedNum2:null,
  lastCard:      null,
  lastCard2:     null,
  lastDual:      false,
  isLightMode:  false,
  gamePolling:  null,
  lobbyPolling: null,
  prevCalledLen:0,
};

/* ── API HELPER ── */
async function api(method, path, body = null) {
  const headers = { 'Content-Type': 'application/json' };
  if (S.tgUser) headers['X-Tg-User'] = JSON.stringify(S.tgUser);
  const opts = { method, headers };
  if (body) opts.body = JSON.stringify(body);
  const res = await fetch(API_BASE + path, opts);
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
  return data;
}

/* ── INIT ── */
window.addEventListener('DOMContentLoaded', async () => {
  if (window.Telegram?.WebApp) {
    const tg = window.Telegram.WebApp;
    tg.ready(); tg.expand();
    tg.setHeaderColor?.('#0d1a11');
    tg.setBackgroundColor?.('#080f0b');
  }
  const tgRaw = window.Telegram?.WebApp?.initDataUnsafe?.user;
  if (tgRaw) {
    S.tgUser = tgRaw;
    document.getElementById('welcome-greeting').innerHTML = `<strong>${tgRaw.first_name}!</strong>`;
  } else {
    S.tgUser = { id: 'dev_' + Date.now(), username: 'DevPlayer', first_name: 'Dev' };
    document.getElementById('welcome-greeting').innerHTML = '<strong>Player!</strong>';
  }
  const saved = localStorage.getItem('bb_theme');
  if (saved === 'light') applyTheme(true, false);

  // Show loading dots while attempting auth — retry up to 5x for cold starts
  showScreen('screen-welcome');
  const btn = document.getElementById('btn-welcome');
  if (btn) { btn.textContent = '⏳ Connecting…'; btn.disabled = true; }

  let authRes = null;
  for (let attempt = 0; attempt < 5; attempt++) {
    try {
      authRes = await api('POST', '/api/auth', { tg_user: S.tgUser });
      break;
    } catch (e) {
      if (attempt < 4) await new Promise(r => setTimeout(r, 2000 * (attempt + 1)));
    }
  }

  if (btn) { btn.textContent = '◈ ENTER GAME'; btn.disabled = false; }

  if (!authRes) return; // server unreachable — stay on welcome, user can tap manually

  if (authRes.status === 'existing') {
    S.user = authRes.user;
    onLoggedIn();
    const urlBet = parseInt(new URLSearchParams(location.search).get('bet'));
    if (urlBet && BET_AMOUNTS.includes(urlBet)) {
      setTimeout(() => {
        const card = document.querySelector(`.bet-tile[data-amount="${urlBet}"]`);
        if (card) selectBet(urlBet, card);
      }, 200);
    }
    return;
  } else if (authRes.status === 'new') {
    const inp = document.getElementById('input-username');
    if (inp) inp.value = authRes.suggested_username || '';
  }
  // status === 'new' — stay on welcome screen for manual tap
});

/* ── WELCOME ── */
async function handleWelcomeClick() {
  const btn = document.getElementById('btn-welcome');
  btn.textContent = '⏳ Connecting…'; btn.disabled = true;
  try {
    const res = await api('POST', '/api/auth', { tg_user: S.tgUser });
    if (res.status === 'existing') {
      S.user = res.user; onLoggedIn();
    } else {
      const inp = document.getElementById('input-username');
      if (inp && res.suggested_username) inp.value = res.suggested_username;
      const urlRef = new URLSearchParams(location.search).get('ref');
      if (urlRef) document.getElementById('reg-ref-id').value = urlRef;
      showScreen('screen-register');
    }
  } catch (e) {
    toast('Connection error — try again', 'error');
    btn.textContent = '◈ ENTER GAME'; btn.disabled = false;
  }
}

/* ── REGISTER ── */
function requestTgPhone() {
  if (!window.Telegram?.WebApp?.requestContact) {
    toast('Open in Telegram to share phone', 'info'); return;
  }
  window.Telegram.WebApp.requestContact((ok, contact) => {
    if (!ok || !contact?.contact?.phone_number) return;
    const ph = contact.contact.phone_number;
    const el = document.getElementById('input-phone');
    if (el) { el.value = ph; toast('Phone number filled from Telegram!', 'success'); }
  });
}

async function submitRegister() {
  const username = document.getElementById('input-username').value.trim();
  const phone    = document.getElementById('input-phone').value.trim();
  const refId    = document.getElementById('reg-ref-id').value.trim();
  if (!username) { toast('Enter a username', 'error'); return; }
  if (!phone)    { toast('Phone number is required', 'error'); return; }
  const phoneClean = phone.replace(/[\s\-]/g, '');
  if (!/^(\+?251|0)[0-9]{9}$/.test(phoneClean)) {
    toast('Enter a valid Ethiopian phone number', 'error'); return;
  }
  if (username.length < 2 || username.length > 20) { toast('Username: 2–20 characters', 'error'); return; }
  try {
    const res = await api('POST', '/api/register', {
      tg_id: S.tgUser.id, username, phone: phone.replace(/[\s\-]/g, ''),
      referred_by: refId ? parseInt(refId) : null
    });
    S.user = res.user;
    onLoggedIn();
  } catch (e) { toast(e.message, 'error'); }
}

/* ── LOGGED IN ── */
async function onLoggedIn() {
  renderHeader();
  document.getElementById('header').style.display = 'flex';
  document.getElementById('bottom-nav').style.display = 'flex';
  const _f = document.getElementById('benz-footer');
  if (_f) _f.style.display = 'block';
  try {
    const games = await api('GET', '/api/games');
    const myUsername = S.user?.username;
    const myActive = myUsername && games.find(g =>
      ['waiting','countdown','active'].includes(g.status) &&
      (g.players||[]).some(p => p.username === myUsername)
    );
    if (myActive) {
      const full = await api('GET', '/api/games/' + myActive.id);
      if (full.my_player) {
        S.currentGameId = full.id;
        S.myCard   = full.my_player.card || null;
        S.myMarked = full.my_player.marked_cells || [[2,2]];
        showScreen('screen-game');
        startGameScreen();
        return;
      }
    }
  } catch (_) {}
  showScreen('screen-lobby');
  setActiveNav('nav-play');
  startLobbyPolling();
}

