async function doLeave(confirmed) {
  document.getElementById('leave-modal').classList.remove('open');
  if (!confirmed) return;
  clearTimeout(S.gamePolling);
  _stopCountdownTick(); _stopCallTicker();
  const gid = S.currentGameId;
  S.gamePolling = null;
  if (gid) {
    try {
      const res = await api('POST', `/api/games/${gid}/leave`, {});
      if (res.refunded) {
        S.currentGameId=null; S.myCard=null; S.myCard2=null;
        S.myMarked=[[2,2]]; S.myMarked2=[[2,2]]; S.dualCard=false; _countdownStarted=false; _inGame=false;
