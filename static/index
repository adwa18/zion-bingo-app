  const el = document.getElementById('admin-games-list');
  try {
    const games = await api('GET', '/api/admin/games');
    const active = games.filter(g=>['waiting','countdown','active'].includes(g.status));
    if (!active.length) { el.innerHTML = '<div class="empty">No active games.</div>'; return; }
    el.innerHTML = active.map(g=>`
      <div class="game-item">
        <div>
          <div class="game-id">${g.id}</div>
          <div class="game-meta">${g.player_count||0}P · ${g.bet_amount} ETB · ${statusLabel(g.status)}</div>
        </div>
        <button class="btn btn-danger btn-sm" onclick="adminForceFinish('${g.id}')">End</button>
      </div>`).join('');
  } catch (_) { el.innerHTML = '<div class="empty">Error loading.</div>'; }
}
async function loadAdminUsers() {
  const el = document.getElementById('admin-users-list');
  const q  = document.getElementById('admin-user-search')?.value.trim() || '';
  try {
    const res   = await api('GET', '/api/admin/users' + (q ? `?q=${encodeURIComponent(q)}` : ''));
    const users = res.users || [];
    const total = res.total || 0;
    const dl = document.getElementById('admin-uname-list');
    if (dl) dl.innerHTML = users.map(u=>`<option value="${u.username}">${u.username} — ${u.balance.toLocaleString()} ETB</option>`).join('');
    const countEl = document.getElementById('admin-user-count');
    if (countEl) countEl.textContent = q ? `(${users.length} found)` : `(${total} total)`;
    if (!users.length) { el.innerHTML = '<div class="empty">No users found.</div>'; return; }
    el.innerHTML = users.map(u=>`
      <div class="user-row-admin" onclick="document.getElementById('admin-uname').value='${u.username}'">
        <div class="u-avatar">${u.username[0].toUpperCase()}</div>
        <div style="flex:1">
          <div class="u-name">${u.username}${u.is_admin?'<span class="u-badge badge-admin">ADMIN</span>':''}</div>
          <div class="u-meta">${u.wins}W · ${u.games_played}G · ${u.balance.toLocaleString()} ETB · TG:${u.tg_id}</div>
        </div>
      </div>`).join('');
  } catch (_) { el.innerHTML = '<div class="empty">Error loading.</div>'; }
}
async function adminSetAdmin(makeAdmin) {
  const username = (document.getElementById('admin-promote-uname')?.value||'').trim();
  if (!username) { toast('Enter a username','error'); return; }
  try {
    const res = await api('GET', '/api/admin/users');
    const users = res.users || res;
    const target = users.find(u=>u.username===username);
    if (!target) { toast('User not found','error'); return; }
    await api('POST', `/api/admin/users/${target.id}/admin`, { is_admin: makeAdmin });
    toast(makeAdmin ? `✅ ${username} is now admin` : `✅ ${username} admin removed`,'success');
    loadAdminUsers();
  } catch(e) { toast(e.message||'Error','error'); }
}
async function adminAdjust() {
  const username = document.getElementById('admin-uname').value.trim();
  const amount   = parseInt(document.getElementById('admin-amt').value);
  if (!username || isNaN(amount)) { toast('Fill username and amount','error'); return; }
  try {
    const res = await api('POST','/api/admin/funds',{username,amount});
    toast(`${res.username}: ${res.new_balance.toLocaleString()} ETB`,'success');
    loadAdminStats();
  } catch(e) { toast(e.message,'error'); }
}
async function adminForceFinish(gid) {
  if (!confirm(`End game ${gid}? Players refunded.`)) return;
  try {
    const res = await api('POST',`/api/admin/games/${gid}/finish`);
    toast(`Game ended. ${res.refunded} refunded.`,'success');
    loadAdminGames();
  } catch(e) { toast(e.message,'error'); }
}

